rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Admin tunggal dikenali dari email (belum pakai custom claim).
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'admin@sditbinainsanmulia.sch.id';
    }

    // ---------- Konten publik website (tulis hanya admin) ----------
    match /schoolProfile/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /announcements/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /galleryItems/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /ppdbOpenings/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ---------- Pendaftaran PPDB ----------
    // Daftar & cek status boleh publik (fitur status). Ubah/hapus hanya admin.
    // Catatan: read publik masih membocorkan PII pendaftar; untuk menutup
    // sepenuhnya butuh server route (Admin SDK) yang memverifikasi nomor.
    match /ppdbRegistrations/{doc} {
      allow create: if true;
      allow read: if true;
      allow update, delete: if isAdmin();
    }

    // ---------- Users: hanya owner & admin ----------
    // User hanya boleh baca/tulis doc miliknya sendiri (di-key email).
    // Field role immutabel bagi non-admin (cegah escalasi jadi admin).
    match /users/{email} {
      allow read: if isAdmin() || (request.auth != null && request.auth.token.email == email);
      allow create: if request.auth != null && (isAdmin() || request.auth.token.email == email);
      allow update: if request.auth != null && (
        isAdmin()
        || (request.auth.token.email == email && request.resource.data.role == resource.data.role)
      );
      allow delete: if isAdmin() || (request.auth != null && request.auth.token.email == email);
    }

    // ---------- Data operasional (guru & orang tua, sudah login) ----------
    // Scoping per-anak sudah dilakukan di sisi client. Enforcing per-role
    // (mis. ortu hanya baca anak sendiri) butuh custom claim — lihat catatan.
    match /classes/{doc} {
      allow read, write: if request.auth != null;
    }
    match /subjects/{doc} {
      allow read, write: if request.auth != null;
    }
    match /students/{doc} {
      allow read, write: if request.auth != null;
    }
    match /attendances/{doc} {
      allow read, write: if request.auth != null;
    }
    match /scores/{doc} {
      allow read, write: if request.auth != null;
    }
    match /violations/{doc} {
      allow read, write: if request.auth != null;
    }
    match /permissions/{doc} {
      allow read, write: if request.auth != null;
    }
    match /schedules/{doc} {
      allow read, write: if request.auth != null;
    }
  }
}
