rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Admin dikenali dari custom claim `role` ATAU fallback email (sampai
    // semua akun mendapat claim). Ortu dikenali dari claim `role == 'orang_tua'`.
    function isAdmin() {
      return request.auth != null
        && (request.auth.token.role == 'admin'
            || request.auth.token.email == 'admin@sditbinainsanmulia.sch.id');
    }
    function notOrtu() {
      return request.auth != null && request.auth.token.role != 'orang_tua';
    }

    // ---------- Konten publik website (tulis hanya admin) ----------
    match /schoolProfile/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /announcements/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /galleryItems/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /ppdbOpenings/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ---------- Pendaftaran PPDB ----------
    // Daftar publik. Baca & ubah hanya via server/admin (tutup kebocoran PII).
    match /ppdbRegistrations/{doc} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // ---------- Users: hanya owner & admin ----------
    // Field role immutabel bagi non-admin (cegah escalasi jadi admin).
    match /users/{email} {
      allow read: if isAdmin() || (request.auth != null && request.auth.token.email == email);
      allow create: if request.auth != null && (isAdmin() || request.auth.token.email == email);
      allow update: if request.auth != null && (
        isAdmin()
        || (request.auth.token.email == email && request.resource.data.role == resource.data.role)
      );
      allow delete: if isAdmin() || (request.auth != null && request.auth.token.email == email);
    }

    // ---------- Data operasional ----------
    // Baca: semua pengguna login. Tulis: semua kecuali ortu (claim 'orang_tua').
    // Catatan: akun tanpa claim (belum di-stempel) masih bisa tulis; setelah
    // claims rollout, peran lebih ketat. Scoping per-anak tetap di sisi client.
    match /classes/{doc} {
      allow read: if request.auth != null;
      allow write: if notOrtu();
    }
    match /subjects/{doc} {
      allow read: if request.auth != null;
      allow write: if notOrtu();
    }
    match /students/{doc} {
      allow read: if request.auth != null;
      allow write: if notOrtu();
    }
    match /attendances/{doc} {
      allow read: if request.auth != null;
      allow write: if notOrtu();
    }
    match /scores/{doc} {
      allow read: if request.auth != null;
      allow write: if notOrtu();
    }
    match /violations/{doc} {
      allow read: if request.auth != null;
      allow write: if notOrtu();
    }
    match /permissions/{doc} {
      allow read: if request.auth != null;
      allow write: if notOrtu();
    }
    match /schedules/{doc} {
      allow read: if request.auth != null;
      allow write: if notOrtu();
    }
  }
}
