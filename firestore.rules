rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Role diambil dari dokumen users/{email}.role (bukan dari custom claim),
    // sehingga admin yang sudah punya akun role=admin langsung berhak tulis
    // tanpa perlu stemple claim. Tidak ada lagi ketergantungan email magic.
    function userRole() {
      let e = request.auth.token.email;
      return request.auth != null && e != null
        ? (exists(/databases/$(database)/documents/users/$(e))
            ? get(/databases/$(database)/documents/users/$(e)).data.role
            : null)
        : null;
    }
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.role == 'admin'
        || request.auth.token.email == 'admin@sditbinainsanmulia.sch.id'
        || userRole() == 'admin'
      );
    }
    function notOrtu() {
      return request.auth != null && userRole() != 'orang_tua';
    }

    // ---------- Konten publik website (tulis hanya admin) ----------
    match /schoolProfile/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /announcements/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /galleryItems/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /ppdbOpenings/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ---------- Pendaftaran PPDB ----------
    match /ppdbRegistrations/{doc} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // ---------- Users: hanya owner & admin ----------
    // Read dibuka untuk user login (dibutuhkan rules untuk baca role).
    match /users/{email} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && (isAdmin() || request.auth.token.email == email);
      allow update: if request.auth != null && (
        isAdmin()
        || (request.auth.token.email == email && request.resource.data.role == resource.data.role)
      );
      allow delete: if isAdmin() || request.auth.token.email == email;
    }

    // ---------- Data operasional ----------
    // Baca: semua user login. Tulis: semua kecuali ortu (role orang_tua).
    match /classes/{doc} {
      allow read: if request.auth != null;
      allow write: if notOrtu();
    }
    match /subjects/{doc} {
      allow read: if request.auth != null;
      allow write: if notOrtu();
    }
    match /students/{doc} {
      allow read: if request.auth != null;
      allow write: if notOrtu();
    }
    match /attendances/{doc} {
      allow read: if request.auth != null;
      allow write: if notOrtu();
    }
    match /scores/{doc} {
      allow read: if request.auth != null;
      allow write: if notOrtu();
    }
    match /violations/{doc} {
      allow read: if request.auth != null;
      allow write: if notOrtu();
    }
    match /permissions/{doc} {
      allow read: if request.auth != null;
      allow write: if notOrtu();
    }
    match /schedules/{doc} {
      allow read: if request.auth != null;
      allow write: if notOrtu();
    }
  }
}
