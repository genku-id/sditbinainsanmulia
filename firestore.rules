rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Konten publik website
    match /schoolProfile/{doc} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /announcements/{doc} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /galleryItems/{doc} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /ppdbOpenings/{doc} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    // Pendaftaran PPDB: publik bisa daftar & cek status sendiri;
    // perubahan status hanya oleh admin (sudah login)
    match /ppdbRegistrations/{doc} {
      allow create: if true;
      allow read: if true;
      allow update, delete: if request.auth != null;
    }

    // Data operasional aplikasi (guru & orang tua) — wajib login
    match /users/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
    match /classes/{doc} {
      allow read, write: if request.auth != null;
    }
    match /subjects/{doc} {
      allow read, write: if request.auth != null;
    }
    match /students/{doc} {
      allow read, write: if request.auth != null;
    }
    match /attendances/{doc} {
      allow read, write: if request.auth != null;
    }
    match /scores/{doc} {
      allow read, write: if request.auth != null;
    }
    match /violations/{doc} {
      allow read, write: if request.auth != null;
    }
    match /permissions/{doc} {
      allow read, write: if request.auth != null;
    }
    match /schedules/{doc} {
      allow read, write: if request.auth != null;
    }
  }
}
